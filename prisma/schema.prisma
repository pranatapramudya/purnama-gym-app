generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN_KASIR
  TRAINER
  MEMBER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CashFlowType {
  INCOME
  EXPENSE
}

model User {
  id          String    @id @default(cuid())
  shortId     String?   @unique
  clerkUserId String    @unique
  email       String    @unique
  name        String?
  phoneNumber String?
  address     String?
  role        Role      @default(MEMBER)
  endDate     DateTime? // Kapan membership berakhir
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions Transaction[]
  checkIns     CheckIn[]
  bookings     ClassBooking[]
  cashFlows    CashFlow[]
  ptSessionsAsMember  PTSession[] @relation("PTMember")
  ptSessionsAsTrainer PTSession[] @relation("PTTrainer")
  ptScheduleSlotsAsTrainer PTScheduleSlot[] @relation("ptScheduleTrainer")
}

model Transaction {
  id        String            @id @default(cuid())
  amount    Float
  type      String // "HARIAN", "BULANAN_REGULAR", "BULANAN_VIP", "PAKET_ZUMBA"
  method    String // "TUNAI", "TRANSFER"
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  adminId String? // Kasir yang memproses
}

model CheckIn {
  id            String    @id @default(cuid())
  timestamp     DateTime  @default(now())
  checkOutTime  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model GymClass {
  id          String   @id @default(cuid())
  name        String // e.g. "Zumba", "Pilates"
  description String? // Deskripsi kelas untuk tampilan admin
  category    String   @default("Umum") // Kategori kelas
  schedule    DateTime
  capacity    Int

  bookings ClassBooking[]
}

model ClassBooking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  classId  String
  gymClass GymClass @relation(fields: [classId], references: [id])
}

model MembershipPackage {
  id             String   @id @default(cuid())
  name           String   // misal: "1 Bulan", "3 Bulan"
  description    String?  // Fasilitas paket
  durationMonths Int      // Durasi paket dalam bulan
  price          Float
  originalPrice  Float?   // Harga coret
  isPopular      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GuideVideo {
  id        String   @id @default(cuid())
  title     String
  url       String   // link YouTube
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CashFlow {
  id          String       @id @default(cuid())
  type        CashFlowType
  amount      Float
  description String
  
  adminId     String
  admin       User         @relation(fields: [adminId], references: [id])
  
  createdAt   DateTime     @default(now())
}

model PTSession {
  id              String    @id @default(cuid())
  schedule        DateTime
  status          String    @default("PENDING") // PENDING, CONFIRMED, ONGOING, COMPLETED
  
  memberId        String
  member          User      @relation("PTMember", fields: [memberId], references: [id])
  
  trainerId       String?
  trainerName     String?
  trainer         User?     @relation("PTTrainer", fields: [trainerId], references: [id])
  
  actualStartTime DateTime?
  actualEndTime   DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PTSetting {
  id                 String   @id @default(cuid())
  pricePerSession    Int      @default(0)
  discountPercentage Int?     @default(0)
  availableDays      String[] @default(["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"])
  startTime       String   @default("08:00")
  endTime         String   @default("20:00")
  updatedAt       DateTime @updatedAt
}

model PTScheduleSlot {
  id                 String      @id @default(cuid())
  dayOfWeek          String
  targetDate         DateTime?
  startTime          String
  endTime            String
  trainerId          String?
  trainerName        String?
  trainer            User?       @relation("ptScheduleTrainer", fields: [trainerId], references: [id])
  maxCapacity        Int         @default(1)
  price              Int         @default(0)
  discountPercentage Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt
}
